@model List<Movie>
@{
    ViewData["Title"] = "Manage Movies";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Movies</h2>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle"></i> Add Movie</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Poster</th>
                <th>Title</th>
                <th>Genre</th>
                <th>Duration</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(movie.PosterPath))
                        {
                            <img src="@movie.PosterPath" style="height:50px;width:35px;object-fit:cover;" />
                        }
                        else
                        {
                            <span class="text-muted">No poster</span>
                        }
                    </td>
                    <td>@movie.Title</td>
                    <td>@movie.Genre</td>
                    <td>@movie.DurationMinutes min</td>
                    <td>@movie.ReleaseDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@movie.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this movie?')">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
