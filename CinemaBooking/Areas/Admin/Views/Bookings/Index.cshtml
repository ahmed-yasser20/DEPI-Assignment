@model List<Booking>
@{
    ViewData["Title"] = "All Bookings";
    Layout = "_Layout";
}

<h2 class="mb-4">All Bookings</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Customer</th>
                <th>Movie</th>
                <th>Cinema</th>
                <th>Showtime</th>
                <th>Seats</th>
                <th>Total</th>
                <th>Booked At</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.User.FullName<br /><small class="text-muted">@booking.User.Email</small></td>
                    <td>@booking.Showtime.Movie.Title</td>
                    <td>@booking.Showtime.Hall.Cinema.Name</td>
                    <td>@booking.Showtime.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@booking.NumberOfSeats</td>
                    <td>$@booking.TotalPrice</td>
                    <td>@booking.BookedAt.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
