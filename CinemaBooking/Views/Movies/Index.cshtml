@model List<Movie>
@{
    ViewData["Title"] = "Movies";
}

<h2 class="mb-4"><i class="bi bi-film"></i> All Movies</h2>

<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-md-3 col-sm-6">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(movie.PosterPath))
                {
                    <img src="@movie.PosterPath" class="card-img-top movie-poster" alt="@movie.Title" />
                }
                else
                {
                    <div class="card-img-top movie-poster d-flex align-items-center justify-content-center bg-secondary">
                        <i class="bi bi-film" style="font-size:4rem;color:#ccc;"></i>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@movie.Title</h5>
                    <p class="text-muted small">@movie.Genre &bull; @movie.DurationMinutes min</p>
                    <p class="card-text small">@(movie.Description.Length > 80 ? movie.Description[..80] + "..." : movie.Description)</p>
                </div>
                <div class="card-footer">
                    <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-danger w-100">View & Book</a>
                </div>
            </div>
        </div>
    }
</div>
