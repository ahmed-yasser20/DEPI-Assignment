@model List<Movie>
@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold">Welcome to <span style="color:#e94560">CinemaBooking</span></h1>
    <p class="lead text-muted">Browse movies and book your tickets online</p>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-danger btn-lg mt-2">
        <i class="bi bi-film"></i> Browse All Movies
    </a>
</div>

<h3 class="mb-4">Now Showing</h3>

<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-md-4 col-sm-6">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(movie.PosterPath))
                {
                    <img src="@movie.PosterPath" class="card-img-top movie-poster" alt="@movie.Title" />
                }
                else
                {
                    <div class="card-img-top movie-poster d-flex align-items-center justify-content-center bg-secondary">
                        <i class="bi bi-film" style="font-size:4rem;color:#ccc;"></i>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@movie.Title</h5>
                    <p class="text-muted small">@movie.Genre &bull; @movie.DurationMinutes min</p>
                    <p class="card-text small">@(movie.Description.Length > 100 ? movie.Description[..100] + "..." : movie.Description)</p>
                    <span class="badge bg-info">@movie.Showtimes.Count showtimes</span>
                </div>
                <div class="card-footer">
                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="btn btn-danger w-100">
                        View Details & Book
                    </a>
                </div>
            </div>
        </div>
    }
</div>
