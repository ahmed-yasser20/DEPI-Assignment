@{
    ViewData["Title"] = "Server Error";
}

<div class="text-center py-5">
    <h1 class="display-1 text-warning">500</h1>
    <h3>Something Went Wrong</h3>
    <p class="text-muted">An unexpected error occurred. Please try again later.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">Go Home</a>
</div>
